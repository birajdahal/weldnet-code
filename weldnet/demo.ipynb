    "# Load config and create model\n",
    "ldon_config = load_config(\"../configs/experiments/ldon.yaml\")\n",
    "ldon_helper = LDONHelper(ldon_config)\n",
    "\n",
    "k_ldon = ldon_config.aeparams.encodeSeq[-1]  # latent dim\n",
    "p_ldon = ldon_config.donparams.tseq[-1]      # trunk output dim\n",
    "\n",
    "ldon = ldon_helper.create_ldon(\n",
    "    dataset,\n",
    "    k=k_ldon,\n",
    "    p=p_ldon,\n",
    "    seed=SEED,\n",
    "    device=DEVICE,\n",
    ")\n",
    "\n",
    "print(f\"LDON created:\")\n",
    "print(f\"  AE: {num_params(ldon.aenet):,} params\")\n",
    "print(f\"  Branch: {num_params(ldon.don['branch']):,} params\")\n",
    "print(f\"  Trunk: {num_params(ldon.don['trunk']):,} params\")\n",
    "print(f\"  Latent dim k={ldon.k}, trunk dim p={ldon.p}\")"
   ]
