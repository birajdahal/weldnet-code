   "source": [
    "---\n",
    "## 1. Data: Burgers Equation\n",
    "\n",
    "The paper uses 1D Burgers equation data:\n",
    "- Spatial resolution: 512 points\n",
    "- Temporal resolution: 201 timesteps\n",
    "- Number of samples: 500\n",
    "- Scaled to [-1, 1]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Dataset: bscale\n",
      "Data shape: (500, 301, 512) (samples, time, space)\n",
      "Params shape: (500, 1)\n",
      "Spatial dim: 1\n",
      "Scale factor: 0.2340\n"
     ]
    }
   ],
   "source": [
    "# Load dataset\n",
    "data_config = load_config(\"../configs/data/burgers/burgersscale.yaml\")\n",
    "dataset = DynamicData(data_config)\n",
    "\n",
    "print(f\"Dataset: {dataset.name}\")\n",
    "print(f\"Data shape: {dataset.data.shape} (samples, time, space)\")\n",
    "print(f\"Params shape: {dataset.params.shape}\")\n",
    "print(f\"Spatial dim: {dataset.spacedim}\")\n",
    "print(f\"Scale factor: {dataset.scale:.4f}\")"
   ]
