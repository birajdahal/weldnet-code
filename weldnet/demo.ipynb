    "---\n",
    "## 3. WeldNet (PCA Autoencoder)\n",
    "\n",
    "WeldNet with PCA-based compression. Uses 10 temporal windows with separate PCA models per window.\n",
    "- Latent dimension: 4\n",
    "- Dynamics network: FFNet per window"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Windows: [[0, 150], [150, 300]]\n",
      "Windows: 2\n",
      "Latent dim: 4\n"
     ]
    }
   ],
   "source": [
    "# Load config and create model\n",
    "weld_pca_config = load_config(\"../configs/experiments/weldpca.yaml\")\n",
    "weld_helper = WeldHelper(weld_pca_config)\n",
    "\n",
    "weld_pca = weld_helper.create_weld(\n",
    "    dataset,\n",
    "    k=4,\n",
    "    seed=SEED,\n",
    "    device=DEVICE,\n",
    "    windows=2\n",
    ")\n",
    "\n",
    "print(f\"Windows: {weld_pca.W}\")\n",
    "print(f\"Latent dim: {weld_pca_config.aeparams.reduced}\")"
   ]
