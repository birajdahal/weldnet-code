     ]
    }
   ],
   "source": [
    "# Load config and create model\n",
    "ldnet_config = load_config(\"../configs/experiments/latent/ldnet.yaml\")\n",
    "ld_helper = LDHelper(ldnet_config)\n",
    "\n",
    "ldnet = ld_helper.create_ldnet(\n",
    "    dataset,\n",
    "    k=ldnet_config.dynparams.seq[0],\n",
    "    seed=SEED,\n",
    "    device=DEVICE,\n",
    ")\n",
    "\n",
    "print(f\"LDNet created:\")\n",
    "print(f\"  Dynamics net: {num_params(ldnet.dynnet):,} params\")\n",
    "print(f\"  Reconstruction net: {num_params(ldnet.recnet):,} params\")"
   ]
